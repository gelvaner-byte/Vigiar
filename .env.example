# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Supabase Dashboard > Project Settings > API)

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Opcional: só mude se quiser usar um e-mail diferente para o login único do app.
# Precisa ser IGUAL ao e-mail do usuário criado em Authentication > Users no Supabase.
VITE_APP_LOGIN_EMAIL=acesso@vigiar.app
